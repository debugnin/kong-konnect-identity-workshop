# ──────────────────────────────────────────────────────────────────────────────
# Copy to environment/.env and fill in the CUSTOMER-PROVIDED section.
#   cp environment/.env.example environment/.env
# Values already exported in your shell always win over this file.
# NEVER commit environment/.env.
# ──────────────────────────────────────────────────────────────────────────────

# ── CUSTOMER-PROVIDED (required) ──────────────────────────────────────────────
# Konnect personal access token (Konnect UI → avatar → Personal access tokens).
# The token's user needs org-admin, or Identity Admin + Control Plane Admin.
KONNECT_TOKEN=

# Konnect geo that hosts the control plane AND the Kong Identity directory.
# They must be in the same region. Examples: us, eu, au, me, in, sg
KONNECT_REGION=us

# ── PRECONFIGURED DEMO VALUES (safe defaults; change only if you must) ────────
CONTROL_PLANE_NAME=kong-identity-workshop
KONG_IMAGE=kong/kong-gateway:3.16
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0.7
HTTPBIN_IMAGE=mccutchen/go-httpbin:2.26.0
KEYCLOAK_REALM=kong-workshop
API_AUDIENCE=kong-workshop-api
DEMO_CLIENT_ID=workshop-demo-client
UNMAPPED_CLIENT_ID=workshop-unmapped-client
PRINCIPAL_NAME=workshop-demo-client
CONSUMER_USERNAME=workshop-demo-consumer

# Claim Kong Identity uses to match the token to a principal.
# `sub` is the documented default. In Keycloak, `sub` of a client-credentials
# token is the *service-account user's UUID* (not the client_id); script 01b reads it.
OIDC_CLAIM_NAME=sub

# ── GENERATED BY THE SCRIPTS (do not set by hand) ─────────────────────────────
# Stored in .generated/state.env: DEMO_CLIENT_SECRET, UNMAPPED_CLIENT_SECRET,
# KC_ADMIN_PASSWORD, DECK_TOKEN_SALT, CONTROL_PLANE_ID, DIRECTORY_ID,
# DIRECTORY_NAME, PRINCIPAL_ID, OIDC_ISSUER, OIDC_SUBJECT, CONSUMER_ID,
# CG_STANDARD_ID, CG_GOLD_ID
